# --- Database ---
# Local dev uses SQLite. For production, point at PostgreSQL.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-dev-only"
# Cookie name for the session JWT
SESSION_COOKIE="fp_session"

# --- Encryption (integration credentials at rest) ---
# 32-byte hex key. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Demo mode ---
# When true, the app seeds clearly-labeled demo data for new workspaces.
DEMO_MODE="true"

# --- Webhooks ---
# Optional shared secret used to verify incoming webhook signatures (HMAC-SHA256).
WEBHOOK_SECRET=""

# --- AI provider ---
# "mock" for local dev/tests. "openai" requires OPENAI_API_KEY.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
# Optional: OpenAI-compatible base URL (default https://api.openai.com/v1)
# and model (default gpt-4o-mini). Only used when AI_PROVIDER=openai.
#OPENAI_BASE_URL="https://api.openai.com/v1"
#AI_MODEL="gpt-4o-mini"

# --- App ---
# Canonical public site origin — used for SEO canonicals, Open Graph URLs,
# and the sitemap. Set to your real production origin before launch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Legacy alias (still honored as a fallback). Prefer NEXT_PUBLIC_SITE_URL.
#NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (transactional: verification codes, password resets) ---
# Resend (https://resend.com). When unset, auth emails are NOT sent and the
# API answers an honest 503 EMAIL_NOT_CONFIGURED instead of pretending.
RESEND_API_KEY=""
# Verified sender identity, e.g. "FlowPilot <noreply@example.com>"
EMAIL_FROM=""

# --- Meta (Instagram / Facebook Messenger / WhatsApp) ---
# Create at https://developers.facebook.com/apps — app type: Business.
# Add products: Messenger, Instagram, WhatsApp. Never commit real values.
META_APP_ID=""
META_APP_SECRET=""
# Random string YOU invent; must match the Verify Token you enter in the Meta app dashboard webhook config.
META_VERIFY_TOKEN=""
# Public HTTPS base URL of this deployment, e.g. https://flowpilot.example.com
# Used for the OAuth redirect URI and shown in webhook setup docs.
APP_PUBLIC_URL="http://localhost:3000"
# Optional: pin/override the Meta Graph API version (default v21.0).
META_GRAPH_VERSION="v21.0"
# Instagram Business Login uses a separate Instagram App ID/Secret
# (App Dashboard > Instagram > API setup with Instagram login >
# Business login settings). REQUIRED for Instagram — these differ from
# META_APP_ID/SECRET. Using the Facebook App ID causes Meta's
# "Invalid platform app" error.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# --- TikTok (Login Kit) ---
# Create at https://developers.tiktok.com/ — enable Login Kit for web.
# Whitelist the redirect URI: {APP_PUBLIC_URL}/api/integrations/tiktok/callback
# Requested scope: user.info.basic (account identity only — no messaging API).
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- SMS (v0.4.0: provider abstraction only — NO provider is configured) ---
# Set SMS_PROVIDER to a provider name only after wiring that provider's adapter;
# today the SMS status endpoint honestly reports SMS_PROVIDER_NOT_CONFIGURED.
#SMS_PROVIDER=""
#SMS_API_KEY=""

# --- AI Prospecting search provider (v0.4.0: NO provider is configured) ---
# Searches land in BLOCKED_NO_SOURCE until a search/business-data provider is
# wired. Do not set these expecting results today.
#SEARCH_PROVIDER=""
#SEARCH_API_KEY=""
